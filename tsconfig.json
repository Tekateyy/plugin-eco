{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "outDir": "out",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  // Borné à src/ : samples/ contient un exemple .ts qui est une donnée de test,
  // pas une source à compiler.
  "include": ["src"],
  "exclude": ["node_modules", "out", ".vscode-test"]
}
