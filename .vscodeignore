.vscode/**
.claude/**
.github/**
CLAUDE.md
.gitignore
scripts/**
samples/**
src/**
test/**
tsconfig.json
out/**/*.map

# Les .d.ts servent le paquet npm ; le .vsix n'a pas de consommateur TypeScript.
out/**/*.d.ts

# tree-sitter-wasms est une devDependency : seul tree-sitter-java.wasm
# est repris dans out/wasm/ au build.
node_modules/tree-sitter-wasms/**

# Doublon de 188 Ko : initParser() pointe locateFile() vers out/wasm/,
# le runtime ne cherche jamais le .wasm voisin de tree-sitter.js.
node_modules/web-tree-sitter/tree-sitter.wasm
node_modules/web-tree-sitter/tree-sitter-web.d.ts
node_modules/web-tree-sitter/README.md
